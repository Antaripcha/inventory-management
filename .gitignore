# Dependencies
node_modules/

# Build outputs
dist/
build/
.turbo/
.next/
out/

# Environment files (Ignores all .env files across root, client, server, etc.)
.env
.env.*
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploads & Media (Keep directory structures via .gitkeep)
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# Testing & Coverage
coverage/
.nyc_output/

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db

